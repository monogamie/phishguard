# PhishGuard Backend — переменные окружения
# Скопируйте в .env и заполните своими значениями:  cp .env.example .env
#
# ВНИМАНИЕ: .env содержит секреты и не должен попадать в git.
# Он уже добавлен в .gitignore — не убирайте его оттуда.

# ── Google Safe Browsing ─────────────────────────────────────
# Бесплатный ключ: https://console.cloud.google.com/
# Включить "Safe Browsing API" → Credentials → Create API key
# Бесплатная квота: 10 000 запросов в сутки.
# Обязательно ограничьте ключ по API в консоли Google —
# неограниченный ключ при утечке даёт доступ ко всем сервисам проекта.
GOOGLE_SAFE_BROWSING_KEY=

# ── URLhaus (abuse.ch) ───────────────────────────────────────
# С 2024 года требуется Auth-Key даже на бесплатном тарифе.
# Бесплатная регистрация: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# ── Анализ языковой моделью (уровень 1c) ─────────────────────
# ЕДИНСТВЕННЫЙ ПЛАТНЫЙ ИСТОЧНИК. Без этого ключа уровень просто
# выключается, остальные четыре работают как обычно.
# Ключ: https://console.anthropic.com/settings/keys
# Тарифы: https://www.anthropic.com/pricing
#
# Сколько стоит: один скан — это примерно 700 входных и 150 выходных
# токенов. Повторные сканы того же адреса берутся из кеша и бесплатны.
# Доверенные домены (google.com и т.п.) на этот уровень не отправляются.
ANTHROPIC_API_KEY=

# Модель. По умолчанию claude-opus-5 — самая точная.
# Дешевле: claude-sonnet-5, ещё дешевле: claude-haiku-4-5.
# AI_MODEL=claude-opus-5

# Выключить уровень, не убирая ключ:
# AI_ENABLED=false

# Границы влияния модели на балл. РАСШИРЯТЬ ОСТОРОЖНО: это главная
# защита от prompt injection через проверяемый URL.
# AI_MAX_DELTA=35
# AI_MIN_DELTA=-15

# ── CORS ─────────────────────────────────────────────────────
# В продакшене укажите домен своего фронтенда вместо "*",
# иначе любой сайт сможет расходовать ваши квоты от имени
# браузера пользователя.
# ALLOWED_ORIGINS=https://phishguard.example.com

# ── Пороги риска (необязательно, показаны значения по умолчанию) ──
# PHISHING_THRESHOLD=60
# SUSPICIOUS_MIN=30

# ── Безопасность ─────────────────────────────────────────────
# Защита от SSRF. Выключать ТОЛЬКО для локальной разработки,
# когда нужно сканировать 127.0.0.1.
# BLOCK_PRIVATE_ADDRESSES=true

# ── Ограничение частоты запросов ─────────────────────────────
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW=60

# ── Режим ────────────────────────────────────────────────────
# ENVIRONMENT=production
# DEBUG_DETAILS=false
